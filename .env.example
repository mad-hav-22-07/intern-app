# Supabase — the forum's database.
# Without these the forum still works, but posts are saved to localStorage and
# are private to one browser. See supabase/migrations/0001_forum.sql.
#
# Provision via the Vercel Marketplace:
#   vercel integration add supabase --yes
#   vercel env pull .env.local --yes
# then mirror the values here under VITE_ names (Vite only exposes VITE_*).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Judge0 — the compiler behind the coding rounds in Mock Exam.
# Unset is fine: it falls back to the public Community Edition instance, which
# needs no key. JavaScript never uses this; it runs in the browser.
# Set these to move to your own Judge0, or to a RapidAPI-hosted one:
#   VITE_JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   VITE_JUDGE0_KEY=<rapidapi key>
#   VITE_JUDGE0_HOST=judge0-ce.p.rapidapi.com
VITE_JUDGE0_URL=
VITE_JUDGE0_KEY=
VITE_JUDGE0_HOST=
